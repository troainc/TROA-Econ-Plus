<?xml version="1.0" encoding="utf-8"?>
<EconPlusConfig>
  <Enabled>true</Enabled>
  <!-- Econ+ stores authoritative balances by Steam ID64 in TROA-Econ-PlusData/Accounts.xml. -->
  <UseInternalAccounts>true</UseInternalAccounts>
  <!-- Import each player's current Keen balance once when their Econ+ account is first created. -->
  <ImportKeenBalanceOnFirstUse>true</ImportKeenBalanceOnFirstUse>
  <!-- Optional compatibility mirror. Econ+ remains authoritative if Keen banking is unavailable. -->
  <MirrorBalancesToKeen>true</MirrorBalancesToKeen>
  <NewAccountStartingCredits>10000</NewAccountStartingCredits>
  <InGameDisplayName>Econ+</InGameDisplayName>
  <EnablePlayerTransfers>true</EnablePlayerTransfers>
  <MinimumTransferCredits>1</MinimumTransferCredits>
  <MaximumTransferCredits>1000000000</MaximumTransferCredits>
  <TransferCooldownSeconds>3</TransferCooldownSeconds>
  <TransferFeePercent>0</TransferFeePercent>
  <PlayerTransferTaxPercent>0</PlayerTransferTaxPercent>
  <MaximumCombinedChargeCredits>0</MaximumCombinedChargeCredits>
  <ChargeDestination>Treasury</ChargeDestination>
  <ExemptSteamIds></ExemptSteamIds>
  <ExemptSourcePlugins></ExemptSourcePlugins>
  <TreasuryFactionTag>ADMIN</TreasuryFactionTag>
  <EnablePluginApi>true</EnablePluginApi>
  <ApiVersion>1.1.0</ApiVersion>
  <EnableEscrow>true</EnableEscrow>
  <MaximumEscrowCredits>1000000000</MaximumEscrowCredits>
  <EscrowExpirationHours>72</EscrowExpirationHours>
  <EnablePayroll>false</EnablePayroll>
  <ScheduledJobPollSeconds>60</ScheduledJobPollSeconds>
  <MaximumScheduledJobsPerRun>25</MaximumScheduledJobsPerRun>
  <MaximumRewardCredits>1000000000</MaximumRewardCredits>
  <RequireFundedTreasuryPayouts>true</RequireFundedTreasuryPayouts>
  <AuditExportDirectory>AuditExports</AuditExportDirectory>
  <StatementMaximumRows>100</StatementMaximumRows>
  <AuditRetentionDays>365</AuditRetentionDays>
  <EnableRiskControls>true</EnableRiskControls>
  <AllowedApiPlugins>Hangar+</AllowedApiPlugins>
  <VelocityWindowMinutes>10</VelocityWindowMinutes>
  <MaximumTransactionsPerWindow>20</MaximumTransactionsPerWindow>
  <MaximumCreditsPerWindow>5000000000</MaximumCreditsPerWindow>
  <DailyTransferLimitCredits>10000000000</DailyTransferLimitCredits>
  <AnomalyLargeTransferPercent>80</AnomalyLargeTransferPercent>
  <EnableReputationSignals>true</EnableReputationSignals>
  <EnableTaxes>false</EnableTaxes>
  <EnableNexusSynchronization>false</EnableNexusSynchronization>
  <NexusChannelId>872034190422</NexusChannelId>
  <NexusServerId></NexusServerId>
  <NexusAuthorityServerId></NexusAuthorityServerId>
  <NexusLockSeconds>30</NexusLockSeconds>
  <NexusReplayRetentionDays>30</NexusReplayRetentionDays>
  <EnableAnalytics>true</EnableAnalytics>
  <AnalyticsDefaultDays>7</AnalyticsDefaultDays>
  <EnableCreditProducts>true</EnableCreditProducts>
  <EnablePlayerLoanApplications>true</EnablePlayerLoanApplications>
  <MaximumPlayerRequestedLoanCredits>1000000</MaximumPlayerRequestedLoanCredits>
  <MaximumLoanPrincipalCredits>100000000</MaximumLoanPrincipalCredits>
  <LoanAnnualInterestPercent>5</LoanAnnualInterestPercent>
  <MaximumLoanTermDays>30</MaximumLoanTermDays>
  <LoanPaymentIntervalDays>7</LoanPaymentIntervalDays>
  <MaximumActiveLoansPerPlayer>1</MaximumActiveLoansPerPlayer>
  <!-- Name an owned LCD/text surface with this tag to show the owner's account dashboard. -->
  <EnablePlayerLcdDisplays>true</EnablePlayerLcdDisplays>
  <LcdNameTag>[ECON+]</LcdNameTag>
  <LcdRefreshSeconds>30</LcdRefreshSeconds>
  <LcdRecentTransactions>5</LcdRecentTransactions>
  <EnableDiscordWebhook>false</EnableDiscordWebhook>
  <DiscordWebhookUrl></DiscordWebhookUrl>
  <DiscordWebhookName>Econ+</DiscordWebhookName>
  <DiscordNotifyCompleted>true</DiscordNotifyCompleted>
  <DiscordNotifyRefunded>true</DiscordNotifyRefunded>
  <DiscordNotifyFailed>false</DiscordNotifyFailed>
  <DiscordNotifyRecoveryRequired>true</DiscordNotifyRecoveryRequired>
  <DiscordWebhookQueueLimit>100</DiscordWebhookQueueLimit>
</EconPlusConfig>
