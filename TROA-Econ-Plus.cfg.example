<?xml version="1.0" encoding="utf-8"?>
<EconPlusConfig>
  <Enabled>true</Enabled>
  <!-- Econ+ stores authoritative balances by Steam ID64 in TROA-Econ-PlusData/Accounts.xml. -->
  <UseInternalAccounts>true</UseInternalAccounts>
  <!-- Import each player's current Keen balance once when their Econ+ account is first created. -->
  <ImportKeenBalanceOnFirstUse>true</ImportKeenBalanceOnFirstUse>
  <!-- Optional compatibility mirror. Econ+ remains authoritative if Keen banking is unavailable. -->
  <MirrorBalancesToKeen>true</MirrorBalancesToKeen>
  <NewAccountStartingCredits>10000</NewAccountStartingCredits>
  <EnableOfflinePayments>true</EnableOfflinePayments>
  <EnableNamedAccounts>true</EnableNamedAccounts>
  <MaximumNamedAccountsPerPlayer>5</MaximumNamedAccountsPerPlayer>
  <EnableScheduledPayments>true</EnableScheduledPayments>
  <ScheduledPaymentPollSeconds>60</ScheduledPaymentPollSeconds>
  <EnableFactionAccounts>true</EnableFactionAccounts>
  <FactionApprovalThresholdCredits>1000000</FactionApprovalThresholdCredits>
  <FactionDailySpendingLimitCredits>10000000</FactionDailySpendingLimitCredits>
  <!-- Faction payroll: an authorized faction founder/leader pays every eligible faction member a
       flat amount from the faction's Econ+ treasury (an admin-created Faction account whose tag
       matches the faction). Money moves only through the authoritative Econ+ accounting layer, and
       every run is recorded with the initiator's Steam ID for fraud review (!econadmin payrolls). -->
  <EnableFactionPayroll>true</EnableFactionPayroll>
  <!-- true = only the founder may run payroll; false = founder OR any leader-ranked officer. -->
  <FactionPayrollFoundersOnly>false</FactionPayrollFoundersOnly>
  <!-- true = the initiating founder/leader is paid as a normal member; false = they are skipped. -->
  <FactionPayrollIncludesInitiator>true</FactionPayrollIncludesInitiator>
  <!-- Per-initiator cooldown guarding against an accidental duplicate payroll run. -->
  <FactionPayrollCooldownSeconds>30</FactionPayrollCooldownSeconds>
  <!-- Safety bound on how many members a single payroll run may pay. -->
  <MaximumFactionPayrollRecipients>500</MaximumFactionPayrollRecipients>
  <!-- Upper bound on the flat per-member amount a payroll run may specify. -->
  <MaximumFactionPayrollCreditsPerMember>100000000</MaximumFactionPayrollCreditsPerMember>
  <!-- Government taxation: a designated "government" faction (GovernmentFactionTag) owns a Faction
       treasury that collects a recurring flat per-player tax. Unpaid amounts become arrears with a
       grace period and late fee; Econ+ keeps collecting up to a per-cycle cap (the "taxman") and,
       at extreme debt, can suspend a player's economy privileges and flag them for staff. All money
       moves through the authoritative Econ+ accounting layer, never native Keen banking. Off by
       default: set the tag, create its Faction treasury, then set EnableGovernmentTax=true. -->
  <EnableGovernmentTax>false</EnableGovernmentTax>
  <!-- The faction tag that IS the government. An admin must create its treasury:
       !econadmin factionaccount create <tag> "name". -->
  <GovernmentFactionTag></GovernmentFactionTag>
  <GovernmentTaxPerPlayerCredits>1000</GovernmentTaxPerPlayerCredits>
  <!-- Assessment interval in minutes. 43200 ~= 30 days of real server uptime ("monthly"). -->
  <GovernmentTaxIntervalMinutes>43200</GovernmentTaxIntervalMinutes>
  <!-- Grace period after a debt first appears before late fees begin (minutes). -->
  <GovernmentTaxGracePeriodMinutes>4320</GovernmentTaxGracePeriodMinutes>
  <GovernmentTaxLateFeePercent>5</GovernmentTaxLateFeePercent>
  <!-- Maximum credits the taxman auto-collects from one player per cycle toward arrears. -->
  <GovernmentTaxMaxCollectedPerCycleCredits>5000</GovernmentTaxMaxCollectedPerCycleCredits>
  <!-- Arrears at or above this are "extreme" and can trigger suspension / admin flagging. -->
  <GovernmentTaxExtremeDebtCredits>50000</GovernmentTaxExtremeDebtCredits>
  <GovernmentTaxSuspendPrivilegesOnExtremeDebt>true</GovernmentTaxSuspendPrivilegesOnExtremeDebt>
  <GovernmentTaxFlagAdminsOnExtremeDebt>true</GovernmentTaxFlagAdminsOnExtremeDebt>
  <!-- Steam ID64s never taxed (comma/space separated). The government treasury owner and its
       managers are always exempt automatically. -->
  <GovernmentTaxExemptSteamIds></GovernmentTaxExemptSteamIds>
  <GovernmentTaxPollSeconds>300</GovernmentTaxPollSeconds>
  <!-- ============================ Governing body / territories ============================
       A federated government model. The server owner's faction is the "United Faction" (a Federal
       government); any faction can be chartered as its own Regional/Local government over territory.
       Territory = zones around named grids (space or planet). Governments earn docking fees, trade
       tariffs, extraction royalties, and periodic territory tax (routed to their Faction treasury,
       with an optional federal cut), and spend on citizen stipends, bonds, and grants. All money
       moves through the authoritative Econ+ accounting layer; location is a world read only.
       Quickest setup: create a Faction treasury for your tag, then run !econadmin gov preset <tag>.
       Off by default. -->
  <EnableTerritories>false</EnableTerritories>
  <EnableDockingFees>false</EnableDockingFees>
  <DockingFeeCooldownSeconds>600</DockingFeeCooldownSeconds>
  <EnableTerritoryTariffs>false</EnableTerritoryTariffs>
  <EnableExtractionRoyalty>false</EnableExtractionRoyalty>
  <!-- Percent of regional/local territorial revenue that goes to the federal United treasury. -->
  <FederalCutPercent>0</FederalCutPercent>
  <MaxDockingFeeCredits>100000</MaxDockingFeeCredits>
  <MaxTerritoryTariffPercent>25</MaxTerritoryTariffPercent>
  <MaxTerritoryRoyaltyPercent>25</MaxTerritoryRoyaltyPercent>
  <MaxTerritoryTaxPerCycleCredits>1000000</MaxTerritoryTaxPerCycleCredits>
  <MaxTerritoryZonesPerGovernment>20</MaxTerritoryZonesPerGovernment>
  <MaxGovernments>50</MaxGovernments>
  <TerritoryTaxIntervalMinutes>43200</TerritoryTaxIntervalMinutes>
  <GovernancePollSeconds>300</GovernancePollSeconds>
  <!-- Citizen stipend / UBI: governments with a stipend policy pay active residents each cycle. -->
  <EnableCitizenStipend>false</EnableCitizenStipend>
  <StipendIntervalMinutes>43200</StipendIntervalMinutes>
  <MaxStipendPerCitizenCredits>1000000</MaxStipendPerCitizenCredits>
  <MaxStipendRecipientsPerCycle>1000</MaxStipendRecipientsPerCycle>
  <!-- Player-chartered governments and elections. -->
  <EnableGovernmentCharters>false</EnableGovernmentCharters>
  <GovernmentCharterFeeCredits>1000000</GovernmentCharterFeeCredits>
  <EnableElections>false</EnableElections>
  <ElectionDefaultDurationMinutes>1440</ElectionDefaultDurationMinutes>
  <!-- Sovereign finance: government bonds and a federal central-bank loan-APR override. -->
  <EnableGovernmentBonds>false</EnableGovernmentBonds>
  <BondCouponIntervalMinutes>10080</BondCouponIntervalMinutes>
  <MaxBondFaceValueCredits>1000000</MaxBondFaceValueCredits>
  <MaxBondCouponPercent>25</MaxBondCouponPercent>
  <EnableCentralBankAprOverride>false</EnableCentralBankAprOverride>
  <EnableMaintenanceMode>true</EnableMaintenanceMode>
  <EnableKeenReconciliation>true</EnableKeenReconciliation>
  <EnableAccountRecovery>true</EnableAccountRecovery>
  <EnableSignedBackups>true</EnableSignedBackups>
  <!-- Place migration CSV/XML files only in TROA-Econ-PlusData/Imports. Imports require explicit IMPORT confirmation. -->
  <EnableMigrationImports>true</EnableMigrationImports>
  <MigrationImportDirectory>Imports</MigrationImportDirectory>
  <InGameDisplayName>Econ+</InGameDisplayName>
  <CurrencyName>credits</CurrencyName>
  <CurrencySymbol>cr</CurrencySymbol>
  <EnableHudNotifications>true</EnableHudNotifications>
  <EnableInGameMessages>true</EnableInGameMessages>
  <MessageOnPaymentReceived>true</MessageOnPaymentReceived>
  <MessageOnPaymentSent>false</MessageOnPaymentSent>
  <MessageOnScheduledPayment>true</MessageOnScheduledPayment>
  <MessageOnLoanReminder>true</MessageOnLoanReminder>
  <InGameMessageFont>Green</InGameMessageFont>
  <EnablePlayerTransfers>true</EnablePlayerTransfers>
  <MinimumTransferCredits>1</MinimumTransferCredits>
  <MaximumTransferCredits>1000000000</MaximumTransferCredits>
  <TransferCooldownSeconds>3</TransferCooldownSeconds>
  <TransferFeePercent>0</TransferFeePercent>
  <PlayerTransferTaxPercent>0</PlayerTransferTaxPercent>
  <MaximumCombinedChargeCredits>0</MaximumCombinedChargeCredits>
  <ChargeDestination>Treasury</ChargeDestination>
  <ExemptSteamIds></ExemptSteamIds>
  <ExemptSourcePlugins></ExemptSourcePlugins>
  <TreasuryFactionTag>ADMIN</TreasuryFactionTag>
  <EnablePluginApi>true</EnablePluginApi>
  <ApiVersion>2.0.0</ApiVersion>
  <EnableEscrow>true</EnableEscrow>
  <MaximumEscrowCredits>1000000000</MaximumEscrowCredits>
  <EscrowExpirationHours>72</EscrowExpirationHours>
  <EnablePayroll>false</EnablePayroll>
  <ScheduledJobPollSeconds>60</ScheduledJobPollSeconds>
  <MaximumScheduledJobsPerRun>25</MaximumScheduledJobsPerRun>
  <MaximumRewardCredits>1000000000</MaximumRewardCredits>
  <RequireFundedTreasuryPayouts>true</RequireFundedTreasuryPayouts>
  <AuditExportDirectory>AuditExports</AuditExportDirectory>
  <StatementMaximumRows>100</StatementMaximumRows>
  <AuditRetentionDays>365</AuditRetentionDays>
  <EnableRiskControls>true</EnableRiskControls>
  <AllowedApiPlugins>Hangar+</AllowedApiPlugins>
  <VelocityWindowMinutes>10</VelocityWindowMinutes>
  <MaximumTransactionsPerWindow>20</MaximumTransactionsPerWindow>
  <MaximumCreditsPerWindow>5000000000</MaximumCreditsPerWindow>
  <DailyTransferLimitCredits>10000000000</DailyTransferLimitCredits>
  <AnomalyLargeTransferPercent>80</AnomalyLargeTransferPercent>
  <EnableReputationSignals>true</EnableReputationSignals>
  <EnableTaxes>false</EnableTaxes>
  <EnableNexusSynchronization>false</EnableNexusSynchronization>
  <NexusChannelId>872034190422</NexusChannelId>
  <NexusServerId></NexusServerId>
  <NexusAuthorityServerId></NexusAuthorityServerId>
  <NexusLockSeconds>30</NexusLockSeconds>
  <NexusReplayRetentionDays>30</NexusReplayRetentionDays>
  <EnableAnalytics>true</EnableAnalytics>
  <AnalyticsDefaultDays>7</AnalyticsDefaultDays>
  <EnableCreditProducts>true</EnableCreditProducts>
  <EnablePlayerLoanApplications>true</EnablePlayerLoanApplications>
  <MaximumPlayerRequestedLoanCredits>1000000</MaximumPlayerRequestedLoanCredits>
  <MaximumLoanPrincipalCredits>100000000</MaximumLoanPrincipalCredits>
  <LoanAnnualInterestPercent>5</LoanAnnualInterestPercent>
  <MaximumLoanTermDays>30</MaximumLoanTermDays>
  <LoanPaymentIntervalDays>7</LoanPaymentIntervalDays>
  <MaximumActiveLoansPerPlayer>1</MaximumActiveLoansPerPlayer>
  <LoanGracePeriodDays>3</LoanGracePeriodDays>
  <LoanLateFeePercent>2</LoanLateFeePercent>
  <MinimumLoanCreditScore>500</MinimumLoanCreditScore>
  <EnableLoanRefinancing>true</EnableLoanRefinancing>
  <EnableAutomaticLoanPayments>false</EnableAutomaticLoanPayments>
  <LoanReminderHours>24</LoanReminderHours>
  <!-- Name an owned LCD/text surface with this tag to show the owner's account dashboard. -->
  <EnablePlayerLcdDisplays>true</EnablePlayerLcdDisplays>
  <LcdNameTag>[ECON+]</LcdNameTag>
  <LcdRefreshSeconds>30</LcdRefreshSeconds>
  <LcdRecentTransactions>5</LcdRecentTransactions>
  <DefaultLcdTemplate>Detailed</DefaultLcdTemplate>
  <LcdFontSize>0.7</LcdFontSize>
  <EnableCommodityMarket>true</EnableCommodityMarket>
  <StationNameTag>[ECON+ STATION]</StationNameTag>
  <StationRadiusMeters>150</StationRadiusMeters>
  <RequireStationProximity>true</RequireStationProximity>
  <MarketPollSeconds>300</MarketPollSeconds>
  <MarketDecayPercentPerPass>2</MarketDecayPercentPerPass>
  <MaximumTradeQuantity>1000000</MaximumTradeQuantity>
  <MarketMakerUsesTreasury>true</MarketMakerUsesTreasury>
  <EnablePhysicalDelivery>true</EnablePhysicalDelivery>
  <AutoScanItemsOnLoad>true</AutoScanItemsOnLoad>
  <IncludeNonPublicItems>false</IncludeNonPublicItems>
  <MarketItemTypes></MarketItemTypes>
  <DefaultItemBasePrice>10</DefaultItemBasePrice>
  <MarketPriceFloorDivisor>4</MarketPriceFloorDivisor>
  <MarketPriceCeilingMultiplier>5</MarketPriceCeilingMultiplier>
  <ScannedItemElasticity>0.5</ScannedItemElasticity>
  <ScannedItemDemandScale>20000</ScannedItemDemandScale>
  <EnableInvestmentExchange>true</EnableInvestmentExchange>
  <InvestPollSeconds>600</InvestPollSeconds>
  <InvestDriftRetain>0.9</InvestDriftRetain>
  <InvestMaxDrift>0.6</InvestMaxDrift>
  <InvestDemandDecayPercent>3</InvestDemandDecayPercent>
  <MaximumInvestQuantity>1000000</MaximumInvestQuantity>
  <EnableAlerts>true</EnableAlerts>
  <EnableLimitOrders>true</EnableLimitOrders>
  <OrderPollSeconds>30</OrderPollSeconds>
  <MaxAlertsPerPlayer>10</MaxAlertsPerPlayer>
  <MaxOrdersPerPlayer>10</MaxOrdersPerPlayer>
  <EnableMarketEvents>true</EnableMarketEvents>
  <MarketEventPollSeconds>600</MarketEventPollSeconds>
  <MarketEventChancePercent>25</MarketEventChancePercent>
  <MarketEventMagnitude>0.8</MarketEventMagnitude>
  <EnableLeaderboards>true</EnableLeaderboards>
  <EnableDividends>false</EnableDividends>
  <DividendIntervalHours>24</DividendIntervalHours>
  <EnableSavingsInterest>false</EnableSavingsInterest>
  <SavingsInterestPercent>2</SavingsInterestPercent>
  <SavingsInterestIntervalHours>24</SavingsInterestIntervalHours>
  <EnablePlayerShops>true</EnablePlayerShops>
  <ShopListingFeePercent>0</ShopListingFeePercent>
  <MaxListingsPerPlayer>10</MaxListingsPerPlayer>
  <ShopListingExpiryDays>0</ShopListingExpiryDays>
  <EnableEconomyReports>true</EnableEconomyReports>
  <InactiveAccountDays>30</InactiveAccountDays>
  <EconomySnapshotIntervalHours>6</EconomySnapshotIntervalHours>
  <EconomySnapshotRetentionDays>365</EconomySnapshotRetentionDays>
  <EnableFraudDetection>true</EnableFraudDetection>
  <FailedPaymentAlertCount>5</FailedPaymentAlertCount>
  <AccountFunnelRecipientCount>5</AccountFunnelRecipientCount>
  <UnusualBalanceChangePercent>50</UnusualBalanceChangePercent>
  <!-- Optional separate staff-controlled channel. Discord webhooks cannot guarantee a true user DM. -->
  <EnablePrivateDiscordBanking>false</EnablePrivateDiscordBanking>
  <DiscordBankingWebhookUrl></DiscordBankingWebhookUrl>
  <EnableDiscordWebhook>false</EnableDiscordWebhook>
  <DiscordWebhookUrl></DiscordWebhookUrl>
  <DiscordWebhookName>Econ+</DiscordWebhookName>
  <DiscordNotifyCompleted>true</DiscordNotifyCompleted>
  <DiscordNotifyRefunded>true</DiscordNotifyRefunded>
  <DiscordNotifyFailed>false</DiscordNotifyFailed>
  <DiscordNotifyRecoveryRequired>true</DiscordNotifyRecoveryRequired>
  <DiscordWebhookQueueLimit>100</DiscordWebhookQueueLimit>
</EconPlusConfig>
